# Copy to hybrid-runtime.local.env privately. All live effects are off by default.
HYBRID_ENABLE_WRITES=false
HYBRID_ENVIRONMENT_KIND=ISOLATED_TEST
HYBRID_EXPECTED_PROJECT_REF=
HYBRID_PROTECTED_PROJECT_REF=
HYBRID_SUPABASE_URL=
HYBRID_SUPABASE_SECRET_KEY=
HYBRID_MQTT_ENABLE=false
MQTT_BROKER_URL=mqtts://YOUR_BROKER_HOST:8883
MQTT_USERNAME=
MQTT_PASSWORD=
HYBRID_NODE_IDS=demo-1,demo-2
HYBRID_FULL_ZONE_COVERAGE=false
HYBRID_STALE_AFTER_MS=90000
HYBRID_DISCONNECTED_AFTER_MS=180000
HYBRID_DIAGNOSTIC_INTERVAL_MS=5000
