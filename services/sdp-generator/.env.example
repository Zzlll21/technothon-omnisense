# This service loads ONLY its own .env when started from this folder.
# No credentials are needed for the default offline dry run.
SDP_ENABLE_WRITES=false
SDP_SUPABASE_URL=https://yourprojectreference.supabase.co
SDP_EXPECTED_PROJECT_REF=yourprojectreference
# Backend only: Secret API Key from the NEW dedicated SDP project (sb_secret_...).
# Paste privately in local .env only. Never use this in VITE_ variables.
SDP_SUPABASE_SECRET_KEY=
# Optional compatibility fallback: legacy service_role JWT. Leave blank when
# using SDP_SUPABASE_SECRET_KEY. Never copy Technothon credentials here.
SDP_SUPABASE_SERVICE_ROLE_KEY=
# Create once with node -e "console.log(require('node:crypto').randomUUID())"
SDP_RUN_ID=
SDP_SEED=42
# Optional UTC timestamp aligned to :00 or :30 seconds. Blank = now on creation.
# Existing runs always resume their stored anchor; do not change it on restart.
SDP_LIVE_ANCHOR=
