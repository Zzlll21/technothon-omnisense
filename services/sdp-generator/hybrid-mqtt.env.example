# Explicitly loaded only for the separate diagnostic runner; no Supabase configuration.
HYBRID_MQTT_ENABLE=false
MQTT_BROKER_URL=mqtts://your-hivemq-cloud-host:8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
# List only deployed identities that this diagnostic should assess.
HYBRID_NODE_IDS=demo-1
# Keep false until physical coverage of the entire cooling zone is validated.
HYBRID_FULL_ZONE_COVERAGE=false
HYBRID_STALE_AFTER_MS=90000
HYBRID_DISCONNECTED_AFTER_MS=180000
HYBRID_DIAGNOSTIC_INTERVAL_MS=5000
