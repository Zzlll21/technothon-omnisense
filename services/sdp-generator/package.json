{
  "name": "@omnisense/sdp-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "node ../../apps/dashboard/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build": "npm --prefix ../../packages/sdp-contract run build && node ../../apps/dashboard/node_modules/typescript/bin/tsc -p tsconfig.json && node --check writer.mjs && node --check index.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node --env-file-if-exists=.env index.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
