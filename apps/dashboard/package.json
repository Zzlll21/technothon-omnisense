{
  "name": "omnisense-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "OmniSense SDP Smart Cooling Management Dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:console": "node --test test/decision-console.test.mjs test/landing-moments.test.mjs",
    "test:records": "node --test test/records.test.mjs",
    "test:overview": "npm --prefix ../../packages/sdp-contract run build && node --test test/overview.test.mjs",
    "test:nodes": "npm --prefix ../../packages/sdp-contract run build && node --test test/node-history.test.mjs",
    "test:predictive": "npm --prefix ../../packages/sdp-contract run build && node --test test/predictive.test.mjs",
    "test:utilization": "npm --prefix ../../packages/sdp-contract run build && node --test test/utilization.test.mjs",
    "test:operating": "npm --prefix ../../packages/sdp-contract run build && node --test test/operating-records.test.mjs",
    "test:overrides": "npm --prefix ../../packages/sdp-contract run build && node --test test/overrides.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.8.2",
    "vite": "^7.2.4"
  }
}
