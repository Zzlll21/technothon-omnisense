{
  "name": "omnisense-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "OmniSense SDP Smart Cooling Management Dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:hybrid": "node --env-file=.env.hybrid.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5178 --strictPort --configLoader runner",
    "build": "tsc --noEmit && vite build",
    "build:hybrid": "tsc --noEmit && node --env-file=.env.hybrid.local node_modules/vite/bin/vite.js build --configLoader runner",
    "package:hybrid": "node --env-file=.env.hybrid.local scripts/prepare-vercel.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:console": "node --test test/decision-console.test.mjs test/landing-moments.test.mjs",
    "test:spatial": "npm --prefix ../../packages/sdp-contract run build && node --test test/spatial-overview.test.mjs test/spatial-zone.test.mjs test/spatial-render.test.mjs test/spatial-cooling.test.mjs test/spatial-records.test.mjs",
    "test:records": "node --test test/records.test.mjs",
    "test:overview": "npm --prefix ../../packages/sdp-contract run build && node --test test/overview.test.mjs",
    "test:nodes": "npm --prefix ../../packages/sdp-contract run build && node --test test/node-history.test.mjs",
    "test:predictive": "npm --prefix ../../packages/sdp-contract run build && node --test test/predictive.test.mjs",
    "test:utilization": "npm --prefix ../../packages/sdp-contract run build && node --test test/utilization.test.mjs",
    "test:operating": "npm --prefix ../../packages/sdp-contract run build && node --test test/operating-records.test.mjs",
    "test:overrides": "npm --prefix ../../packages/sdp-contract run build && node --test test/overrides.test.mjs",
    "dev:site": "node scripts/site.mjs dev",
    "build:site": "tsc --noEmit && node scripts/site.mjs build",
    "preview:site": "node scripts/site.mjs preview",
    "test:site": "node --test test/site-entry.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "typescript": "^5.8.2",
    "vite": "^7.2.4"
  }
}
